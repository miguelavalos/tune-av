{
  "name": "@avalsys/tune-av-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/run-with-varlock.sh vite dev --host 0.0.0.0 --port 5194",
    "dev:preview": "./scripts/run-with-varlock.sh --profile preview vite dev --host 0.0.0.0 --port 5194",
    "build": "./scripts/run-with-varlock.sh vite build",
    "build:preview": "./scripts/run-with-varlock.sh --profile preview vite build",
    "build:production": "./scripts/run-with-varlock.sh --profile production vite build",
    "deploy:preview": "bun run build:preview && bash ../../../../private/avalsys-suite/scripts/wrangler-account.sh deploy --config wrangler.preview.jsonc",
    "deploy:production": "bun run build:production && bash ../../../../private/avalsys-suite/scripts/wrangler-account.sh deploy --config wrangler.production.jsonc",
    "deploy:preview:dry-run": "bun run build:preview && bash ../../../../private/avalsys-suite/scripts/wrangler-account.sh deploy --dry-run --config wrangler.preview.jsonc",
    "deploy:production:dry-run": "bun run build:production && bash ../../../../private/avalsys-suite/scripts/wrangler-account.sh deploy --dry-run --config wrangler.production.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "qa:shared": "node scripts/qa-shared-web.mjs"
  },
  "dependencies": {
    "@avalsys/account-av-web": "file:../../../account-av/web",
