.DS_Store
.idea/
.vscode/
.codex/
node_modules/

# App Store working media
docs/app-store/screenshots/

# Xcode
DerivedData/
.DerivedData*/
.derived-data/
.derived-data-device/
.derived-data-verify/
build/
*.xcresult
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcuserdatad/
*.xcuserstate

# Local secrets
apps/ios/Config/Local.xcconfig

# Override global ignore rules so iOS app sources remain trackable.
!/apps/ios/
!/apps/ios/TuneAV/
!/apps/ios/TuneAV/**

# Override global ignore rules so macOS app sources remain trackable.
!/apps/macos/
!/apps/macos/**

# macOS local config is generated outside this public repository.
apps/macos/Config/Local.xcconfig
apps/macos/Provisioning/
apps/macos/**/*.xcworkspace/xcuserdata/
apps/macos/**/*.xcodeproj/xcuserdata/
apps/macos/**/*.xcuserdatad/
apps/macos/**/*.xcuserstate
