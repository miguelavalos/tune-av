{
  "name": "tuneav",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "config:hygiene": "./scripts/check-public-config-hygiene.sh",
    "i18n:audit": "node ./scripts/check-i18n-parity.mjs",
    "ci:actions-pinning": "./scripts/check-github-actions-pinning.sh",
    "ci:workflow-permissions": "node ./scripts/check-github-workflow-permissions.mjs",
    "ci:workflow-timeouts": "node ./scripts/check-github-workflow-timeouts.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "ios:config:dev": "./scripts/generate-ios-local-xcconfig.sh --env dev",
    "ios:config:prod": "./scripts/generate-ios-local-xcconfig.sh --env prod",
    "ios:check:dev": "./scripts/check-ios-runtime-config.sh --env dev",
    "ios:check:prod": "./scripts/check-ios-runtime-config.sh --env prod",
    "ios:secrets:hygiene": "node ./scripts/check-ios-hardcoded-sensitive-config.mjs",
    "ios:platform:security": "node ./scripts/check-ios-platform-security.mjs",
    "ios:smoke:playback-ats": "./scripts/smoke-ios-playback-ats.sh",
    "ios:smoke:launch-performance": "./scripts/smoke-ios-launch-performance.sh",
    "ios:profile:launch-performance": "./scripts/profile-ios-launch-performance.sh",
    "ios:release-config:hygiene": "./scripts/check-ios-release-config-hygiene.sh --env prod --configuration Release",
    "ios:release:simulator": "./scripts/check-ios-release-simulator-build.sh",
    "ios:release:preflight": "./scripts/ios-release-preflight.sh",
    "ios:release:archive": "./scripts/ios-release-archive-upload.sh",
    "ios:release:upload": "./scripts/ios-release-archive-upload.sh",
    "ios:archive:check": "./scripts/check-ios-release-archive.sh",
    "ios:privacy:release": "./scripts/check-ios-privacy-release-gate.sh --env prod --configuration Release",
    "ios:privacy:network": "./scripts/check-ios-network-privacy.sh",
    "ios:install:dev": "./scripts/install-ios-device.sh --env dev",
    "ios:install:prod": "./scripts/install-ios-device.sh --env prod",
    "ios:ci": "./scripts/ios-ci-test.sh",
    "ios:size-report": "./scripts/report-ios-app-size.sh",
    "ios:ui-smoke": "./scripts/run-ios-ui-tests.sh",
    "ios:tests": "TUNEAV_IOS_SKIP_LAUNCH_PERF_SMOKE=1 ./scripts/ios-ci-test.sh",
    "macos:ci": "./scripts/macos-ci-test.sh",
    "macos:config:dev": "./scripts/generate-macos-local-xcconfig.sh --env dev",
    "macos:config:prod": "./scripts/generate-macos-local-xcconfig.sh --env prod",
    "macos:platform:security": "node ./scripts/check-macos-platform-security.mjs",
    "macos:archive:check": "./scripts/check-macos-archive-signing.sh",
    "macos:check:prod": "./scripts/check-macos-runtime-config.sh --env prod --configuration Release",
    "macos:release-config:hygiene": "./scripts/check-macos-release-config-hygiene.sh --env prod --configuration Release",
    "macos:release:archive": "./scripts/macos-release-archive-upload.sh",
    "macos:release:preflight": "./scripts/macos-release-preflight.sh",
    "macos:release:upload": "./scripts/macos-release-archive-upload.sh",
    "macos:run": "./scripts/build-and-run-macos.sh",
    "macos:tests": "cd apps/macos && xcodebuild test -project TuneAVMac.xcodeproj -scheme TuneAVMac -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO",
    "web": "vp run --filter ./apps/web dev",
    "web:dev": "vp run --filter ./apps/web dev",
    "web:build": "vp run --filter ./apps/web build",
    "web:build:preview": "vp run --filter ./apps/web build:preview",
    "web:build:production": "vp run --filter ./apps/web build:production",
    "web:deploy:preview": "vp run --filter ./apps/web deploy:preview",
    "web:deploy:production": "vp run --filter ./apps/web deploy:production",
    "web:deploy:preview:dry-run": "vp run --filter ./apps/web deploy:preview:dry-run",
    "web:deploy:production:dry-run": "vp run --filter ./apps/web deploy:production:dry-run",
    "web:typecheck": "vp run --filter ./apps/web typecheck"
  },
  "devDependencies": {
    "@varlock/infisical-plugin": "0.0.6",
    "sharp": "^0.34.5",
    "varlock": "^0.0.7",
    "vite-plus": "0.2.2",
    "wrangler": "^4.55.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  }
}
